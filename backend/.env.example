# ---- App ----
# Local dev port for run_dev.py (production platforms set their own $PORT).
APP_PORT=8010

# ---- MongoDB ----
# Use a MongoDB Atlas connection string, or mongodb://localhost:27017 for the local Docker instance.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=airfare_index

# ---- Authentication ----
# Generate a strong random value for production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Demo login account created by the seed script.
DEMO_USER_EMAIL=analyst@airindex.dev
DEMO_USER_PASSWORD=airindex123

# ---- Amadeus Flight Offers Search API (optional) ----
# Create a free self-service app at https://developers.amadeus.com/
# If left blank, the app runs entirely on the labelled synthetic seed dataset.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ---- Collection scheduler ----
COLLECTION_INTERVAL_MINUTES=60
COLLECTION_ENABLED=false

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
